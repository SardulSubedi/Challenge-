KALSHI_API_KEY_ID=replace-with-your-key-id
KALSHI_PRIVATE_KEY_PATH=.secrets/kalshi.key
# Set true only for a key created in the demo environment.
KALSHI_DEMO=false
# Optional endpoint overrides, useful for local mock servers:
# KALSHI_REST_URL=https://external-api.kalshi.com/trade-api/v2
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
